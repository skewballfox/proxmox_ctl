# Copy to .env and fill in values. PVE_HOST, PVE_USER, and TALOS_CLUSTER are required.

# --- Required ---
PVE_HOST=192.168.1.100        # IP or hostname of the Proxmox node
PVE_USER=alice                # SSH user; non-root gets sudo prepended to qm/pvesh commands
TALOS_CLUSTER=homelab         # Cluster name — used as a VM tag and in VM name prefixes

# --- Talos image (optional) ---
# TALOS_VERSION=1.13.0
# TALOS_STORAGE=local-lvm
# TALOS_BRIDGE=vmbr0
# TALOS_IMAGE=/var/lib/vz/template/qcow2/talos-1.13.0.qcow2

# --- Control plane sizing (optional) ---
# TALOS_CP_CORES=2
# TALOS_CP_MEMORY=4096       # MiB
# TALOS_CP_DISK=50           # GiB

# --- Worker sizing (optional) ---
# TALOS_WORKER_CORES=4
# TALOS_WORKER_MEMORY=16384  # MiB (16 GiB)
# TALOS_WORKER_DISK=100      # GiB
